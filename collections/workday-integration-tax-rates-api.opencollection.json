{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workday Integration Workday Absence Management Absence Types Tax Rates API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://{baseUrl}/authorize",
      "accessTokenUrl": "https://{baseUrl}/oauth2/{tenant}/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Tax Rates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Workday Integration Retrieve company SUI rates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{baseUrl}/ccx/api/absenceManagement/v1/{tenant}/companySUIRates",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of objects in a single response (default 20, maximum 100)"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The zero-based index of the first object in a response collection"
              }
            ]
          },
          "docs": "Returns company state unemployment insurance rates."
        },
        {
          "info": {
            "name": "Workday Integration Create a company SUI rate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{baseUrl}/ccx/api/absenceManagement/v1/{tenant}/companySUIRates",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new state unemployment insurance rate entry."
        }
      ]
    }
  ],
  "bundled": true
}